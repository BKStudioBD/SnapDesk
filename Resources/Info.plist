<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>SnapDesk</string>
    <key>CFBundleDisplayName</key>
    <string>SnapDesk</string>
    <key>CFBundleIdentifier</key>
    <string>com.snapdesk.app</string>
    <key>CFBundleShortVersionString</key>
    <string>1.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <!--
      The keys Xcode would have written, and this hand-built plist did not.
      CFBundleDevelopmentRegion is the load-bearing one: ViewBridge asks the
      HOST bundle for its localization when a remote view's window is ordered on
      screen, that lookup goes through `_CFBundleGetValueForInfoKey`, and with
      no development region it throws. The exception escapes through
      `-[NSRemoteView containingWindowWillOrderOnScreen:]` and aborts the
      process. Six of this app's nine recorded crashes are that one stack,
      always while macOS was waking the status item.
    -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>MacOSX</string>
    </array>
    <key>CFBundleSignature</key>
    <string>????</string>
    <!-- Required by App Store Connect, and free to carry either way. -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>

    <!-- Menu-bar app: hide the Dock icon and main window. -->
    <key>LSUIElement</key>
    <true/>

    <!-- Screen recording / capture permission prompt text. -->
    <key>NSScreenCaptureUsageDescription</key>
    <string>SnapDesk needs screen recording access to take screenshots and read text from the screen.</string>

    <!-- Microphone: optional voice track in screen recordings. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>SnapDesk records your voice when the microphone is enabled for screen recordings.</string>

    <!-- Camera: optional webcam bubble in screen recordings. -->
    <key>NSCameraUsageDescription</key>
    <string>SnapDesk shows your webcam as a bubble in screen recordings when enabled.</string>

    <!-- Speech recognition: on-device transcription for burned-in subtitles. -->
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>SnapDesk transcribes recordings on-device to add automatic subtitles.</string>

    <key>NSHumanReadableCopyright</key>
    <string>SnapDesk</string>
</dict>
</plist>
